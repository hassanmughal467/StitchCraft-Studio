# ---------------------------------------------------------------------------
# Environment / indexing
# Indexing, canonicals and the sitemap are enabled ONLY when both values are set
# on the confirmed production deployment. Leave them unset on previews.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Public business details (all optional; unset channels are hidden)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_ADDRESS_LINE1=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---------------------------------------------------------------------------
# Quote intake (server only)
# The public quote form is enabled only when a persistent store is configured.
#   QUOTE_STORE=file      local/dev only: writes to QUOTE_STORE_DIR (default .data/quotes)
# A durable production store adapter must be added before launch (see docs/OWNER_INPUTS_REQUIRED.md).
# ---------------------------------------------------------------------------
QUOTE_STORE=
QUOTE_STORE_DIR=

# Transactional email via Resend (staff notification + customer confirmation).
# Missing values keep quote saving working but mark notifications as "not sent".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_INBOX_EMAIL=
