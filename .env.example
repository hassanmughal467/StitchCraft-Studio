# ---------------------------------------------------------------------------
# Environment / indexing
# Indexing, canonicals and the sitemap are enabled ONLY when both values are set
# on the confirmed production deployment. Leave them unset on previews.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Public business details (all optional; unset channels are hidden)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_RESPONSE_STATEMENT=
NEXT_PUBLIC_ADDRESS_LINE1=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---------------------------------------------------------------------------
# Quote intake (server only)
# The public form is enabled only when a durable store is configured.
#   QUOTE_STORE=file           local/dev: writes to QUOTE_STORE_DIR (default .data/quotes)
#   QUOTE_STORE=memory         tests / single-process only; blocked in production unless
#                              QUOTE_STORE_ALLOW_VOLATILE=true
#   QUOTE_STORE=vercel-blob    production on Vercel; needs BLOB_READ_WRITE_TOKEN
# QUOTE_INTAKE_MODE=offline    deliberate maintenance: form replaced by a notice
# ---------------------------------------------------------------------------
QUOTE_STORE=
QUOTE_STORE_DIR=
QUOTE_STORE_PREFIX=
QUOTE_STORE_ALLOW_VOLATILE=
QUOTE_INTAKE_MODE=
QUOTE_OFFLINE_MESSAGE=
QUOTE_RESPONSE_STATEMENT=
QUOTE_IP_SALT=
QUOTE_ARTWORK_LINK_SECRET=
QUOTE_ARTWORK_LINK_TTL_HOURS=

# Vercel Blob (required when QUOTE_STORE=vercel-blob)
BLOB_READ_WRITE_TOKEN=

# Transactional email
#   EMAIL_PROVIDER=resend  needs RESEND_API_KEY, RESEND_FROM_EMAIL, QUOTE_INBOX_EMAIL
#   EMAIL_PROVIDER=log     development console only (never in production)
# Missing values keep quote saving working but mark notifications as not sent.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_INBOX_EMAIL=

# Optional Cloudflare Turnstile (off unless both keys are set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server log verbosity: debug | info | warn | error
LOG_LEVEL=
